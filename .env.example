# Optional. Without this, the pipeline uses local heuristic analysis and script export.
OPENAI_API_KEY=

# Optional model overrides.
NARRATION_LLM_MODEL=gpt-4.1
NARRATION_TTS_MODEL=gpt-4o-mini-tts

# Optional Langfuse tracing. Install with: python3 -m pip install -e ".[langfuse]"
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENABLED=true
NARRATION_LOG_LEVEL=INFO

# tts backend: script, elevenlabs, openai, or macos_say
NARRATION_TTS_BACKEND=script

# ElevenLabs integration. Set voice ids from your ElevenLabs voice library.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_LANGUAGE_CODE=zh
ELEVENLABS_DEFAULT_VOICE_ID=

# Optional JSON mapping of speaker/role names to ElevenLabs voice IDs.
# Example: {"Narrator":"VOICE_ID_1","汪淼":"VOICE_ID_2","叶文洁":"VOICE_ID_3"}
ELEVENLABS_VOICE_MAP_JSON=

# Optional Supabase cloud persistence. Install with: python3 -m pip install -e ".[supabase]"
# Use a server-only service role key here; never expose it in browser code.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_OWNER_ID=
